<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Gloam Setup" Width="1060" Height="820" MinWidth="940" MinHeight="730" Background="#10151D" Foreground="#E7E9F0" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#BCAAF2"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#28313F"/>
      <Setter Property="Foreground" Value="#F1EFF8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="15,9"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#485365"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#1B2430"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#445165"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="Margin" Value="0,5,0,12"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Margin" Value="0,5,0,12"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Foreground" Value="#12151B"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,8,16,10"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="#ADB8CA"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="160"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,18">
      <TextBlock Text="GLOAM" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
      <TextBlock Text="SD SETUP" FontSize="14" Margin="15,14,0,0" Foreground="#ADB8CA"/>
    </DockPanel>
    <Grid x:Name="TargetBar" Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="SD card or staging folder"/>
        <TextBox x:Name="TargetPath" ToolTip="Choose the root of the SD card, where BOOT.NDS belongs."/>
      </StackPanel>
      <Button x:Name="BrowseTarget" Grid.Column="1" Content="Choose folder..." Margin="12,22,8,12"/>
      <Button x:Name="LoadTarget" Grid.Column="2" Content="Use folder" Margin="0,22,0,12"/>
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="155"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel x:Name="Navigation" Margin="0,0,20,0">
        <Button x:Name="NavSetup" Content="Setup" HorizontalContentAlignment="Left"/>
        <Button x:Name="NavAddons" Content="Add-ons" HorizontalContentAlignment="Left"/>
        <Button x:Name="NavLibrary" Content="Library" HorizontalContentAlignment="Left"/>
        <Button x:Name="NavThemes" Content="Themes" HorizontalContentAlignment="Left"/>
      </StackPanel>
      <Grid x:Name="Workspace" Grid.Column="1">
        <ScrollViewer x:Name="PageSetup" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="4,0,12,0">
            <TextBlock Text="Set up your SD card" Style="{StaticResource Heading}"/>
            <TextBlock Text="Install Gloam and its SD layout, then add your games, apps and media." Style="{StaticResource Muted}"/>
            <CheckBox x:Name="IncludeAddons" Content="Include the bundled emulator and player pack" IsChecked="True"/>
            <WrapPanel>
              <Button x:Name="Install" Content="Install / repair setup" Background="#6B548E"/>
              <Button x:Name="UpdateRuntime" Content="Update Gloam + backends"/>
              <Button x:Name="UpdateFrontend" Content="Update BOOT.NDS only"/>
            </WrapPanel>
            <TextBlock Text="Install fills missing setup files and updates BOOT.NDS. Existing settings, themes, associations, BIOS and saves are kept. Replaced files receive backups." Style="{StaticResource Muted}" Margin="0,8,0,18"/>
            <TextBlock Text="Already set up?" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <WrapPanel>
              <Button x:Name="OpenSd" Content="Open SD folder"/>
              <Button x:Name="OpenBackups" Content="Open setup backups"/>
              <Button x:Name="OpenRelease" Content="Releases and licenses"/>
            </WrapPanel>
            <TextBlock Text="Add-ons includes the complete download catalog, update checks and BIOS guidance. Games and proprietary BIOS are supplied separately." Style="{StaticResource Muted}"/>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="PageAddons" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Emulators and players" Style="{StaticResource Heading}"/>
            <TextBlock Text="Select apps to download directly from their reviewed upstream releases." Style="{StaticResource Muted}"/>
          </StackPanel>
          <WrapPanel Grid.Row="1">
            <Button x:Name="Recommended" Content="Recommended"/>
            <Button x:Name="SelectAll" Content="Select all regular apps"/>
            <Button x:Name="ClearApps" Content="Clear"/>
            <CheckBox x:Name="AllowNc" Content="Allow noncommercial apps" ToolTip="Enable only for personal/no-profit use; each application's terms still apply."/>
          </WrapPanel>
          <DataGrid x:Name="AddonList" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" Background="#17202C" Foreground="#111820" RowBackground="#E6E8EE" AlternatingRowBackground="#D7DCE5" GridLinesVisibility="None" SelectionMode="Single" BorderThickness="0" MinHeight="120" Margin="0,0,0,12">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Get" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
              <DataGridTextColumn Header="Application" Binding="{Binding Id}" Width="*" IsReadOnly="True"/>
              <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="180" IsReadOnly="True"/>
              <DataGridTextColumn Header="Terms / status" Binding="{Binding Terms}" Width="180" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Grid.Row="3">
            <Button x:Name="InstallAddons" Content="Install selected" Background="#6B548E"/>
            <Button x:Name="CheckAddons" Content="Check updates"/>
            <Button x:Name="UpdateAddons" Content="Update selected"/>
            <Button x:Name="CheckSupport" Content="Check BIOS / support"/>
          </WrapPanel>
          <TextBlock Grid.Row="4" Text="Updates preserve settings and saves. Experimental apps need explicit selection; check the activity log for compatibility notes." Foreground="#ADB8CA" Margin="0,0,0,12"/>
        </Grid>
        <ScrollViewer x:Name="PageLibrary" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="4,0,12,0">
            <TextBlock Text="Folders and file handlers" Style="{StaticResource Heading}"/>
            <TextBlock Text="Create folders, assign an emulator or player, and add a tab without editing INI files. Restart Gloam after saving." Style="{StaticResource Muted}"/>
            <Expander Header="Games, Apps and Media folders" Foreground="#E7E9F0" Margin="0,0,0,18">
              <StackPanel Margin="0,12,0,0">
                <TextBlock Text="Games"/>
                <TextBox x:Name="GamesRoot" Text="roms"/>
                <TextBlock Text="Apps"/>
                <TextBox x:Name="AppsRoot" Text="apps"/>
                <TextBlock Text="Media"/>
                <TextBox x:Name="MediaRoot" Text="media"/>
                <Button x:Name="SaveRoots" Content="Save library folders" HorizontalAlignment="Left"/>
              </StackPanel>
            </Expander>
            <TextBlock Text="Emulator / player association" FontSize="18" FontWeight="SemiBold"/>
            <ComboBox x:Name="Profiles" DisplayMemberPath="Name"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Display name"/>
                <TextBox x:Name="ProfileName"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Profile ID"/>
                <TextBox x:Name="ProfileId" ToolTip="A stable filename: lowercase letters, digits, underscores or hyphens."/>
              </StackPanel>
            </Grid>
            <TextBlock Text="File types (for example: gb, gbc, sgb)"/>
            <TextBox x:Name="Extensions"/>
            <TextBlock Text="Application on SD"/>
            <DockPanel>
              <Button x:Name="PickApplication" Content="Browse / import..." DockPanel.Dock="Right" Margin="10,5,0,12"/>
              <TextBox x:Name="Application"/>
            </DockPanel>
            <TextBlock Text="Preferred content folder (created if missing)"/>
            <DockPanel>
              <Button x:Name="PickContent" Content="Browse..." DockPanel.Dock="Right" Margin="10,5,0,12"/>
              <TextBox x:Name="ContentFolder" Text="roms/New System"/>
            </DockPanel>
            <TextBlock Text="Folder rules resolve shared extensions such as .md. Outside those folders, Gloam offers the available handlers." Foreground="#ADB8CA" Margin="0,0,0,12"/>
            <Expander Header="Advanced launch options" Foreground="#E7E9F0" Margin="0,0,0,10">
              <StackPanel Margin="0,10,0,0">
                <TextBlock Text="Separate DS-mode application (optional SD path)"/>
                <TextBox x:Name="DsApplication"/>
                <WrapPanel>
                  <CheckBox x:Name="UseBootstrap" Content="Use nds-bootstrap"/>
                  <CheckBox x:Name="UseHbargv" Content="Homebrew argv file"/>
                </WrapPanel>
              </StackPanel>
            </Expander>
            <WrapPanel><Button x:Name="SaveProfile" Content="Save file handler" Background="#6B548E"/><Button x:Name="CopyContent" Content="Copy ROMs / media into folder..."/></WrapPanel>
            <Separator Margin="0,15,0,18" Background="#354052"/>
            <TextBlock Text="Add or change a folder tab" FontSize="18" FontWeight="SemiBold"/>
            <ComboBox x:Name="Tabs" DisplayMemberPath="Label"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Tab label"/>
                <TextBox x:Name="TabLabel"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Tab ID"/>
                <TextBox x:Name="TabId"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="Folder on SD"/>
            <TextBox x:Name="TabFolder" Text="roms/New System"/>
            <Button x:Name="SaveTab" Content="Save folder and tab" HorizontalAlignment="Left" Background="#6B548E"/>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PageThemes" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="4,0,12,0">
            <TextBlock Text="Themes" Style="{StaticResource Heading}"/>
            <TextBlock Text="Open the themes folder or import a downloaded theme folder. Choose the active theme in Gloam's on-console settings." Style="{StaticResource Muted}"/>
            <ListBox x:Name="ThemeList" Height="185" Background="#1B2430" Foreground="#E7E9F0" BorderThickness="0" Padding="10" Margin="0,0,0,16"/>
            <WrapPanel>
              <Button x:Name="OpenThemes" Content="Open themes folder"/>
              <Button x:Name="ImportTheme" Content="Import theme folder..."/>
            </WrapPanel>
            <TextBlock Text="Import expects a folder containing theme.ini. Existing themes are kept; rename the imported folder to install a second version." Style="{StaticResource Muted}"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Grid Grid.Row="3" Margin="0,18,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock Text="ACTIVITY" Foreground="#ADB8CA" FontSize="11" Margin="0,0,0,6"/>
      <TextBox x:Name="Activity" Grid.Row="1" VerticalContentAlignment="Top" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#0B1017" Margin="0"/>
    </Grid>
    <Grid Grid.Row="4" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="150"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="Status" Text="Choose your SD card or a staging folder." Foreground="#ADB8CA"/>
      <ProgressBar x:Name="Progress" Grid.Column="1" Height="5" Foreground="{StaticResource Accent}" Background="#28313F" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</Window>
