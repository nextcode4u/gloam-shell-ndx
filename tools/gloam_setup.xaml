<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Gloam Setup" Width="1060" Height="820" MinWidth="940" MinHeight="730" Background="#10151D" Foreground="#E7E9F0" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#BCAAF2"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#B4C0D2"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#28313F"/>
      <Setter Property="Foreground" Value="#F1EFF8"/>
      <Setter Property="BorderBrush" Value="#68768B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,9"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter x:Name="ButtonLabel" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface" Property="Background" Value="#364253"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonSurface" Property="Background" Value="#485365"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#BCAAF2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonSurface" Property="Background" Value="#202936"/>
                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#465365"/>
                <Setter TargetName="ButtonLabel" Property="TextElement.Foreground" Value="#B4C0D2"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#1B2430"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#445165"/>
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="Margin" Value="0,5,0,12"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="#B4C0D2"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="TextBox">
                <Border Background="#202936" BorderBrush="#465365" BorderThickness="1" Padding="{TemplateBinding Padding}">
                  <ScrollViewer x:Name="PART_ContentHost"/>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#E6E8EE"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Margin" Value="0,5,0,12"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Foreground" Value="#12151B"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ComboBox">
                <Border Background="#202936" BorderBrush="#465365" BorderThickness="1" Padding="{TemplateBinding Padding}">
                  <DockPanel>
                    <Path DockPanel.Dock="Right" Data="M 0 0 L 8 0 L 4 4 Z" Fill="#B4C0D2" Width="8" Height="4" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" TextElement.Foreground="#B4C0D2" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,8,16,10"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="#ADB8CA"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="160"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,18">
      <TextBlock Text="GLOAM" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
      <TextBlock Text="SD SETUP" FontSize="14" Margin="15,14,0,0" Foreground="#ADB8CA"/>
    </DockPanel>
    <Grid x:Name="TargetBar" Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="SD card or staging folder"/>
        <TextBox x:Name="TargetPath" ToolTip="Choose the root of the SD card, where BOOT.NDS belongs."/>
      </StackPanel>
      <Button x:Name="BrowseTarget" Grid.Column="1" Content="Choose folder..." Margin="12,22,8,12"/>
      <Button x:Name="LoadTarget" Grid.Column="2" Content="Use folder" Margin="0,22,0,12"/>
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="155"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Navigation" Margin="0,0,20,0">
        <Button x:Name="NavSetup" Content="Setup" HorizontalContentAlignment="Left"/>
        <Button x:Name="NavAddons" Content="Add-ons" HorizontalContentAlignment="Left"/>
        <Button x:Name="NavLibrary" Content="Library" HorizontalContentAlignment="Left"/>
        <Button x:Name="NavOrganizer" Content="ROM organizer" HorizontalContentAlignment="Left" Padding="9,9"/>
        <Button x:Name="NavSettings" Content="Settings" HorizontalContentAlignment="Left"/>
        <Button x:Name="NavThemes" Content="Themes" HorizontalContentAlignment="Left"/>
        <Button x:Name="NavMaintenance" Content="Maintenance" HorizontalContentAlignment="Left"/>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="Workspace" Grid.Column="1">
        <ScrollViewer x:Name="PageSetup" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="4,0,12,0">
            <TextBlock Text="Set up your SD card" Style="{StaticResource Heading}"/>
            <TextBlock Text="Install Gloam and its SD layout, then add your games, apps and media." Style="{StaticResource Muted}"/>
            <CheckBox x:Name="IncludeAddons" Content="Include the bundled emulator and player pack" IsChecked="True"/>
            <WrapPanel>
              <Button x:Name="Install" Content="Install / repair setup" Background="#6B548E"/>
              <Button x:Name="UpdateRuntime" Content="Update Gloam + backends"/>
              <Button x:Name="UpdateFrontend" Content="Update BOOT.NDS only"/>
            </WrapPanel>
            <TextBlock Text="Install fills missing setup files and updates BOOT.NDS. Existing settings, themes, associations, BIOS and saves are kept. Replaced files receive backups." Style="{StaticResource Muted}" Margin="0,8,0,18"/>
            <TextBlock Text="Already set up?" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <WrapPanel>
              <Button x:Name="OpenSd" Content="Open SD folder"/>
              <Button x:Name="OpenBackups" Content="Open setup backups"/>
              <Button x:Name="OpenRelease" Content="Releases and licenses"/>
            </WrapPanel>
            <TextBlock Text="Add-ons includes the complete download catalog, update checks and BIOS guidance. Games and proprietary BIOS are supplied separately." Style="{StaticResource Muted}"/>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="PageAddons" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Emulators and players" Style="{StaticResource Heading}"/>
            <TextBlock Text="Select apps to download directly from their reviewed upstream releases." Style="{StaticResource Muted}"/>
          </StackPanel>
          <WrapPanel Grid.Row="1">
            <Button x:Name="Recommended" Content="Recommended"/>
            <Button x:Name="SelectAll" Content="Select all" ToolTip="Select every app, including experimental builds. Noncommercial apps still require the opt-in checkbox before installation."/>
            <Button x:Name="ClearApps" Content="Clear"/>
            <CheckBox x:Name="AllowNc" Content="Allow noncommercial apps" ToolTip="Enable only for personal/no-profit use; each application's terms still apply."/>
          </WrapPanel>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
          <DataGrid x:Name="AddonList" Grid.Column="0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" Background="#17202C" Foreground="#111820" RowBackground="#E6E8EE" AlternatingRowBackground="#D7DCE5" GridLinesVisibility="None" SelectionMode="Single" BorderThickness="0" MinHeight="120" Margin="0,0,0,12">
            <DataGrid.Resources>
              <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#544568"/>
              <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>
              <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#445165"/>
            </DataGrid.Resources>
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Setter Property="ToolTip" Value="{Binding Details}"/>
                <Style.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#544568"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#28313F"/><Setter Property="Foreground" Value="#E7E9F0"/><Setter Property="Padding" Value="8,5"/></Style></DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Get" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
              <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
              <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100" IsReadOnly="True"/>
              <DataGridTextColumn Header="Terms / status" Binding="{Binding Terms}" Width="120" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="12,0,0,12" Background="#17202C" Padding="10">
            <TextBlock x:Name="AddonDetails" TextWrapping="Wrap" Foreground="#E7E9F0" Text="Select an application to see formats, folders and BIOS requirements."/>
          </ScrollViewer>
          </Grid>
          <WrapPanel Grid.Row="3">
            <Button x:Name="InstallAddons" Content="Install selected" Background="#6B548E"/>
            <Button x:Name="CheckAddons" Content="Check updates"/>
            <Button x:Name="UpdateAddons" Content="Update selected"/>
            <Button x:Name="CheckSupport" Content="Check installed BIOS / support"/>
          </WrapPanel>
          <TextBlock Grid.Row="4" Text="Updates preserve settings and saves. Select all includes experimental apps; check the activity log for compatibility notes." Foreground="#ADB8CA" Margin="0,0,0,12"/>
        </Grid>
        <ScrollViewer x:Name="PageLibrary" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="4,0,12,0">
            <TextBlock Text="Folders and file handlers" Style="{StaticResource Heading}"/>
            <TextBlock Text="Create folders, assign an emulator or player, and add a tab without editing INI files. Restart Gloam after saving." Style="{StaticResource Muted}"/>
            <Expander Header="Games, Apps and Media folders" Foreground="#E7E9F0" Margin="0,0,0,18">
              <StackPanel Margin="0,12,0,0">
                <TextBlock Text="Games"/>
                <TextBox x:Name="GamesRoot" Text="roms"/>
                <TextBlock Text="Apps"/>
                <TextBox x:Name="AppsRoot" Text="apps"/>
                <TextBlock Text="Media"/>
                <TextBox x:Name="MediaRoot" Text="media"/>
                <Button x:Name="SaveRoots" Content="Save library folders" HorizontalAlignment="Left"/>
              </StackPanel>
            </Expander>
            <TextBlock Text="Emulator / player association" FontSize="18" FontWeight="SemiBold"/>
            <ComboBox x:Name="Profiles" DisplayMemberPath="Name"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Display name"/>
                <TextBox x:Name="ProfileName"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Profile ID"/>
                <TextBox x:Name="ProfileId" ToolTip="A stable filename: lowercase letters, digits, underscores or hyphens."/>
              </StackPanel>
            </Grid>
            <TextBlock Text="File types (for example: gb, gbc, sgb)"/>
            <TextBox x:Name="Extensions"/>
            <TextBlock Text="Application on SD"/>
            <DockPanel>
              <Button x:Name="PickApplication" Content="Browse / import..." DockPanel.Dock="Right" Margin="10,5,0,12"/>
              <TextBox x:Name="Application"/>
            </DockPanel>
            <TextBlock Text="Preferred content folder (created if missing)"/>
            <DockPanel>
              <Button x:Name="PickContent" Content="Browse..." DockPanel.Dock="Right" Margin="10,5,0,12"/>
              <TextBox x:Name="ContentFolder" Text="roms/New System"/>
            </DockPanel>
            <TextBlock Text="Folder rules resolve shared extensions such as .md. Outside those folders, Gloam offers the available handlers." Foreground="#ADB8CA" Margin="0,0,0,12"/>
            <Expander Header="Advanced launch options" Foreground="#E7E9F0" Margin="0,0,0,10">
              <StackPanel Margin="0,10,0,0">
                <TextBlock Text="Separate DS-mode application (optional SD path)"/>
                <TextBox x:Name="DsApplication"/>
                <WrapPanel>
                  <CheckBox x:Name="UseBootstrap" Content="Use nds-bootstrap"/>
                  <CheckBox x:Name="UseHbargv" Content="Homebrew argv file"/>
                </WrapPanel>
              </StackPanel>
            </Expander>
            <WrapPanel>
              <Button x:Name="SaveProfile" Content="Save file handler" Background="#6B548E"/>
              <Button x:Name="CopyContent" Content="Copy ROMs / media into folder..."/>
            </WrapPanel>
            <Separator Margin="0,15,0,18" Background="#354052"/>
            <TextBlock Text="Add or change a folder tab" FontSize="18" FontWeight="SemiBold"/>
            <ComboBox x:Name="Tabs" DisplayMemberPath="Label"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Tab label"/>
                <TextBox x:Name="TabLabel"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Tab ID"/>
                <TextBox x:Name="TabId"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="Folder on SD"/>
            <TextBox x:Name="TabFolder" Text="roms/New System"/>
            <Button x:Name="SaveTab" Content="Save folder and tab" HorizontalAlignment="Left" Background="#6B548E"/>
          </StackPanel>
        </ScrollViewer>

        <Grid x:Name="PageOrganizer" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Organize a ROM folder" Style="{StaticResource Heading}"/>
            <TextBlock Text="Group loose ROMs into A-Z / # folders, or bring them back. Saves and sidecar art travel with their title; multi-file game folders stay intact." Style="{StaticResource Muted}"/>
            <DockPanel>
              <Button x:Name="PickOrganizerFolder" Content="Other subfolder..." DockPanel.Dock="Right" Margin="10,5,0,12"/>
              <ComboBox x:Name="OrganizerFolder" IsEditable="True" IsTextSearchEnabled="True" ToolTip="System folders from the selected SD card: roms and the configured Games library. Choose a system or type a relative subfolder."/>
            </DockPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="OrganizerMode"/>
              <TextBox x:Name="OrganizerExtensions" Grid.Column="1" Margin="10,5,10,12" ToolTip="Standalone ROM file extensions, separated by commas."/>
              <Button x:Name="PreviewOrganization" Grid.Column="2" Content="Preview moves" Margin="0,5,0,12"/>
            </Grid>
          </StackPanel>
          <DataGrid x:Name="OrganizerPreview" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Background="#17202C" Foreground="#111820" RowBackground="#E6E8EE" AlternatingRowBackground="#D7DCE5" GridLinesVisibility="None" BorderThickness="0" MinHeight="80">
            <DataGrid.Resources>
              <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#445165"/>
            </DataGrid.Resources>
            <DataGrid.ColumnHeaderStyle>
              <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#28313F"/>
                <Setter Property="Foreground" Value="#E7E9F0"/>
                <Setter Property="Padding" Value="8,6"/>
              </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="75"/>
              <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*"/>
              <DataGridTextColumn Header="Destination / reason" Binding="{Binding Destination}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="OrganizerSummary" Text="Preview first. No files are changed until you apply." Foreground="#ADB8CA" Margin="0,0,0,8"/>
            <WrapPanel>
              <Button x:Name="ApplyOrganization" Content="Apply reviewed moves" Background="#6B548E" IsEnabled="False"/>
              <ComboBox x:Name="OrganizerJournals" DisplayMemberPath="Label" SelectedValuePath="Id" Width="290"/>
              <Button x:Name="UndoOrganization" Content="Undo selected" Margin="8,5,0,12"/>
            </WrapPanel>
          </StackPanel>
        </Grid>
        <Grid x:Name="PageSettings" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Launcher settings" Style="{StaticResource Heading}"/>
            <TextBlock Text="Prepare the console on your PC. Changes apply after you save and restart Gloam." Style="{StaticResource Muted}"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SettingsForm" Margin="4,0,12,0">
              <TextBlock Text="Quick presets" FontSize="18" FontWeight="SemiBold"/>
              <WrapPanel>
                <ComboBox x:Name="SetupPreset" Width="190"/>
                <Button x:Name="StagePreset" Content="Review preset" Margin="12,5,0,12"/>
              </WrapPanel>
              <TextBlock Text="Presets stage a few settings for review. Save settings applies them." Style="{StaticResource Muted}"/>
              <TextBlock Text="Simple / Advanced" FontSize="18" FontWeight="SemiBold"/>
              <ComboBox x:Name="SettingMode"/>
              <CheckBox x:Name="SimpleLock" Content="Lock the console to Simple settings"/>
              <TextBlock Text="The console's mode switch is hidden while locked. You can unlock it here later. The lock is off by default." Style="{StaticResource Muted}"/>
              <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,10"/>
              <TextBlock Text="Theme"/>
              <ComboBox x:Name="SettingTheme" DisplayMemberPath="Name" SelectedValuePath="Id"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Accent"/>
                  <ComboBox x:Name="SettingAccent"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Browser view"/>
                  <ComboBox x:Name="SettingView"/>
                </StackPanel>
              </Grid>
              <TextBlock Text="Icon size"/>
              <ComboBox x:Name="SettingIcons"/>
              <WrapPanel>
                <CheckBox x:Name="SettingCovers" Content="Show covers"/>
                <CheckBox x:Name="SettingMotion" Content="Reduced motion"/>
                <CheckBox x:Name="SettingClock" Content="12-hour clock"/>
              </WrapPanel>
              <TextBlock Text="Browsing" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,10"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Sort order"/>
                  <ComboBox x:Name="SettingSort"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Scroll speed"/>
                  <ComboBox x:Name="SettingSpeed"/>
                </StackPanel>
              </Grid>
              <WrapPanel>
                <CheckBox x:Name="SettingHideSaves" Content="Hide save folders"/>
                <CheckBox x:Name="SettingHideBios" Content="Hide BIOS folders"/>
                <CheckBox x:Name="SettingExtensions" Content="Show file extensions"/>
                <CheckBox x:Name="SettingKnown" Content="Recognized file types only"/>
                <CheckBox x:Name="SettingHidden" Content="Show hidden files"/>
                <CheckBox x:Name="SettingSystem" Content="Show system files"/>
                <CheckBox x:Name="SettingTitles" Content="Use internal game titles"/>
              </WrapPanel>
              <TextBlock Text="Game-title language"/>
              <ComboBox x:Name="SettingLanguage"/>
              <TextBlock Text="Startup" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,10"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="16"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Open on startup"/>
                  <ComboBox x:Name="SettingStartup" DisplayMemberPath="Label" SelectedValuePath="Id"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Auto-launch recent request"/>
                  <ComboBox x:Name="SettingAutoLaunch"/>
                </StackPanel>
              </Grid>
              <TextBlock Text="Audio" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,10"/>
              <TextBlock Text="Background music"/>
              <ComboBox x:Name="SettingMusicMode"/>
              <TextBlock Text="Custom music file on SD"/>
              <DockPanel>
                <Button x:Name="PickMusic" Content="Choose WAV..." DockPanel.Dock="Right" Margin="10,5,0,12"/>
                <TextBox x:Name="SettingMusicPath"/>
              </DockPanel>
              <TextBlock Text="Mono PCM16 WAV, 8000-48000 Hz, up to 1 MiB of samples. A PC file can be copied into media/music." Style="{StaticResource Muted}"/>
              <TextBlock Text="Music volume"/>
              <Slider x:Name="SettingMusicVolume" Minimum="0" Maximum="100" TickFrequency="10" Margin="0,10,0,4"/>
              <TextBlock Text="{Binding ElementName=SettingMusicVolume, Path=Value, StringFormat={}{0:0}%}" Foreground="#ADB8CA" Margin="0,0,0,12"/>
              <CheckBox x:Name="SettingSounds" Content="Theme UI sounds"/>
              <TextBlock Text="UI sound volume"/>
              <Slider x:Name="SettingEffectsVolume" Minimum="0" Maximum="100" TickFrequency="10" Margin="0,10,0,4"/>
              <TextBlock Text="{Binding ElementName=SettingEffectsVolume, Path=Value, StringFormat={}{0:0}%}" Foreground="#ADB8CA" Margin="0,0,0,16"/>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <WrapPanel>
              <Button x:Name="SaveSettings" Content="Save settings" Background="#6B548E"/>
              <Button x:Name="ReloadSettings" Content="Reload from SD"/>
            </WrapPanel>
            <TextBlock x:Name="SettingsInfo" Text="Choose an SD folder to load settings." Foreground="#ADB8CA"/>
          </StackPanel>
        </Grid>
        <ScrollViewer x:Name="PageMaintenance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="4,0,12,0">
            <TextBlock Text="Backups and setup checks" Style="{StaticResource Heading}"/>
            <TextBlock Text="Close Gloam or its emulator before editing SD files from the PC." Style="{StaticResource Muted}"/>
            <TextBlock Text="Portable configuration" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock Text="Use the launcher's .dsconfig format to back up settings, favourites, tab definitions, appearance slots and per-title preferences." Style="{StaticResource Muted}"/>
            <WrapPanel>
              <Button x:Name="ExportConfiguration" Content="Export configuration..."/>
              <Button x:Name="ImportConfiguration" Content="Import configuration..."/>
            </WrapPanel>
            <TextBlock Text="Applications, themes, base emulator profiles, BIOS and saves are separate. Imported records are validated first; existing configuration receives backups." Style="{StaticResource Muted}"/>
            <TextBlock Text="Setup health" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,10"/>
            <TextBlock Text="Check required loaders, settings, selected theme and optional emulator paths. Use Add-ons for the installed-app BIOS check." Style="{StaticResource Muted}"/>
            <WrapPanel>
              <Button x:Name="CheckSetup" Content="Check setup"/>
              <Button x:Name="RestoreConsoleSettings" Content="Restore last console settings"/>
              <Button x:Name="OpenConfig" Content="Open configuration folder"/>
              <Button x:Name="MaintenanceBackups" Content="Open setup backups"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="PageThemes" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="4,0,12,0">
            <TextBlock Text="Themes" Style="{StaticResource Heading}"/>
            <TextBlock Text="Open the themes folder or import a downloaded theme folder. Choose the active theme in Gloam's on-console settings." Style="{StaticResource Muted}"/>
            <ListBox x:Name="ThemeList" Height="185" Background="#1B2430" Foreground="#E7E9F0" BorderThickness="0" Padding="10" Margin="0,0,0,16"/>
            <WrapPanel>
              <Button x:Name="OpenThemes" Content="Open themes folder"/>
              <Button x:Name="ApplyTheme" Content="Apply selected theme" Background="#6B548E"/>
              <Button x:Name="ImportTheme" Content="Import theme folder..."/>
            </WrapPanel>
            <CheckBox x:Name="ThemeUseLayout" Content="Use the theme's browser view and icon size" IsChecked="True"/>
            <TextBlock Text="Import expects a folder containing theme.ini. Existing themes are kept; rename the imported folder to install a second version." Style="{StaticResource Muted}"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Grid Grid.Row="3" Margin="0,18,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock Text="ACTIVITY" Foreground="#ADB8CA" FontSize="11" Margin="0,0,0,6"/>
      <TextBox x:Name="Activity" Grid.Row="1" VerticalContentAlignment="Top" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#0B1017" Margin="0"/>
    </Grid>
    <Grid Grid.Row="4" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="150"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="Status" Text="Choose your SD card or a staging folder." Foreground="#ADB8CA"/>
      <ProgressBar x:Name="Progress" Grid.Column="1" Height="5" Foreground="{StaticResource Accent}" Background="#28313F" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</Window>
